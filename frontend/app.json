{
  "expo": {
    "name": "숭팔이",
    "slug": "soongpal",
    "scheme": "soongpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.soongsil.soongpal"
    },
    "android": {
      "package": "com.soongsil.soongpal"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "공동구매 게시글에 사진을 첨부하기 위해 앨범 접근이 필요해요." }
      ]
    ]
  }
}
